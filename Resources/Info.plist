<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>FF大王</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
	  iPad 四向。基础键 UISupportedInterfaceOrientations 保持只有 Portrait ——
	  iPhone 仍锁竖屏（横屏下 932 宽会让 hero 卡排版无意义地拉长），
	  iPad 则需要四向（横屏 1194 才是两列布局的主场景，见设计文档 §1.2）。

	  为什么用 ~ipad 后缀而不是改基础键：后缀键只在 iPad 上生效，
	  基础键对 iPhone/iPad 都生效 —— 改基础键等于放开 iPhone 横屏，属回归。
	-->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  3.7.0：天气卡片用设备定位（设置 → 天气 → 用我的位置，**默认关闭**）。

	  只写 WhenInUse 这一条，刻意**不**写 NSLocationAlwaysAndWhenInUseUsageDescription：
	  · 我们只需要"打开 App 时取一次坐标"，从不后台定位、从不 startUpdatingLocation；
	  · 多写 Always 会在审核时被要求解释"为什么需要始终允许"，而这个问题我们没有正当答案。

	  没有这一条，requestWhenInUseAuthorization() 会直接失败（不弹框、不报错），
	  滑块开关看起来"点了没反应"—— 这是最容易被当成玄学 bug 的一类配置遗漏。
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用你的位置获取当地天气，只用于请求天气接口，不上传、不保存到我们的服务器。</string>
	<!--
	  批次 4：实时活动。Apple 要求写在**宿主 App** 的 Info.plist 上（Widget 扩展不需要）。
	  没有这一条，Activity.request 会直接抛错，锁屏与灵动岛永远不会出现红石活动。
	-->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!--
	  V3.3：小组件深链。桌面小组件点一下 → skyapp://brief / skyapp://rock → 落到对应 Tab。

	  scheme 必须与 `Sources/Widget/WidgetProvider.swift` 的 `WidgetDeepLink.scheme` 和
	  `Sources/App/RootView.swift` 的 `AppDeepLink.scheme` 逐字一致；三处任一改了这里都会"点了没反应"
	  （而且不报错、不崩溃 —— 是最难查的一类 bug）。

	  注意：这条**只写在宿主 App** 上。Widget 扩展不需要声明 scheme，
	  它只是"发出"一个 URL；能接收 URL 的是 App。
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>top.skyzyf.skyapp.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>skyapp</string>
			</array>
		</dict>
	</array>
	<!--
	  3.8.0：云控更新要唤起全能签（nsk-sign://web?url=<ipa 直链>）。

	  这一条**必须加**：iOS 9 起，`UIApplication.canOpenURL(_:)` 对未在本键里声明的
	  scheme **恒返回 false**（而且不报错、不打印任何日志）。少了它，`UpdateInstaller`
	  会在所有设备上都走"没检测到全能签"的兜底分支 —— 明明装了也提示没装，
	  是那种只能靠真机试才发现问题的一类遗漏。

	  只声明 `nsk-sign` 一个：全能签另外两个 scheme（addsource / bookmark）本轮用不到，
	  多声明一个就多一条"这个 App 会去探测哪些 App"的隐私面。
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>nsk-sign</string>
	</array>
</dict>
</plist>
